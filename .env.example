# Server
AGENTLATCH_DB=.agentlatch/state.db
# Optional for localhost; required before exposing the API to other users.
AGENTLATCH_API_TOKEN=
# The browser cannot supply model credentials. Configure them here.
AGENTLATCH_ENABLE_CREW=true
AGENTLATCH_MODEL=ollama_chat/gemma4:31b-cloud
# Set true ONLY for downloaded local models; the selected cloud tag requires false.
AGENTLATCH_LOCAL_ONLY=false
# Leave blank to use provider defaults (Ollama defaults to localhost:11434).
AGENTLATCH_BASE_URL=
# Optional override: the NAME of an environment variable holding a key.
AGENTLATCH_API_KEY_ENV=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OTEL_SDK_DISABLED=true
CREWAI_TELEMETRY_DISABLED=true
